# Ignore rules for the metamaterial diffusion baseline (ROADMAP.md section 5).
#
# Generated binaries (datasets, checkpoints, run artifacts) are not committed;
# the Parquet/CSV manifests and dataset card stay in git to reproduce a run.
#
# Keep comments on their own line: git does not support inline comments, so any
# "#..." after a pattern becomes part of that pattern.

# --- Generated datasets (keep the manifests, drop the binary payload) ---
data/*
!data/*.csv
!data/*.parquet
!data/*.md
!data/README*
!data/.gitkeep
data/checkpoints/

# --- Generated HDF5 / NumPy / mesh binaries anywhere in the tree ---
*.h5
*.hdf5
*.npy
*.npz
*.stl

# The golden-cell regression fixture is source, not a generated artifact: it is
# a small, checked-in reference tensor set that the FEA replay test needs on a
# clean checkout.
!tests/fixtures/
!tests/fixtures/*.npz

# --- Training and evaluation artifacts ---
runs/
outputs/
wandb/
*.pt
*.ckpt
events.out.tfevents.*

# --- Selectively tracked results (override the blanket `outputs/` rule above) ---
# Track only headline legacy results + stale evidence report; keep experiments/audits local.
# A file cannot be re-included while an ancestor is excluded, so un-ignore the
# `outputs/` dir first, then re-include per file type (later rules win).
!outputs/
outputs/*
!outputs/README.md
!outputs/acceptance_30k/
!outputs/ablation_30k/
!outputs/synthetic_30k/
!outputs/evaluate/
outputs/samples/
outputs/diag/
outputs/final_acceptance/
outputs/final_acceptance_v1f/
outputs/ema_validation/
outputs/filter_timing/
outputs/audit/
outputs/acceptance_30k/evidence/
outputs/audit_clamp*/
outputs/audit_sampling_batch/
outputs/*_profile*
outputs/fea_profile.json
outputs/training_profile.*
outputs/physics_precision.json
outputs/physics_proxy_sanity.json
outputs/data_generated_validity.json
outputs/audit_clamp_summary.json

# Do NOT use `!outputs/<dir>/**`: it re-includes every type, leaking the `.npy`
# grids back in. Un-ignore per type instead so the `*.npy` rule above holds.
!outputs/**/*.stl
!outputs/**/*.png
!outputs/**/*.csv
!outputs/**/*.json
!outputs/**/*.md

# --- Local environments (repo-local micromamba prefix; see README) ---
.mamba/
.conda/
.venv/
venv/
env/
bin/

# --- Python build and tool caches ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- DVC internals (keep .dvc/config itself tracked if DVC is adopted) ---
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# --- Secrets and logs ---
.env
*.log

# --- Editors and OS files ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
scripts/
