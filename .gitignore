# Ignore rules for the metamaterial diffusion baseline (ROADMAP.md section 5).
#
# Conventions: generated binaries (datasets, checkpoints, run artifacts) are
# never committed -- version the HDF5 payloads with DVC or equivalent
# checksums -- while the Parquet/CSV manifests and the dataset card stay in git
# because the pipeline needs them to reproduce a run.
#
# Keep comments on their own line: git does not support inline comments, so any
# "#..." after a pattern becomes part of that pattern.

# --- Generated datasets (keep the manifests, drop the binary payload) ---
data/*
!data/*.csv
!data/*.parquet
!data/*.md
!data/README*
!data/.gitkeep
data/checkpoints/

# --- Generated HDF5 / NumPy / mesh binaries anywhere in the tree ---
*.h5
*.hdf5
*.npy
*.npz
*.stl

# --- Training and evaluation artifacts ---
runs/
outputs/
wandb/
*.pt
*.ckpt
events.out.tfevents.*

# --- Local environments (repo-local micromamba prefix; see README) ---
.mamba/
.conda/
.venv/
venv/
env/
bin/

# --- Python build and tool caches ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# --- DVC internals (keep .dvc/config itself tracked if DVC is adopted) ---
.dvc/cache/
.dvc/tmp/
.dvc/config.local

# --- Secrets and logs ---
.env
*.log

# --- Editors and OS files ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
